{
  "name": "@eigentime/one-widget",
  "version": "0.1.2",
  "description": "Static-first, accessible promotion and sponsorship links for Eigentime and other sites.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "typesVersions": {
    "*": {
      "tracking": [
        "./src/tracking.d.ts"
      ]
    }
  },
  "sideEffects": [
    "./src/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./astro": "./src/astro/PromotionLinks.astro",
    "./styles.css": "./src/styles.css",
    "./tracking": {
      "types": "./src/tracking.d.ts",
      "import": "./src/tracking.js",
      "default": "./src/tracking.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test test/model.test.js test/render.test.js test/tracking.test.js test/contract.test.js",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "astro",
    "sponsorship",
    "promotion",
    "support",
    "social-links",
    "static-site"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "astro": "^5 || ^6 || ^7"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  }
}
